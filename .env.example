# Standard: nur lokal erreichbar. Auf der internen Test-VM die freigegebene feste LAN-IP setzen.
HG_WEBSITE_BIND_IP=127.0.0.1

# Erst nach Firmen- und Datenschutzfreigabe aktivieren.
HG_CONTACT_FORM_ENABLED=false
# Eigener Web3Forms-Formularschlüssel für das bestätigte HG-Systeme-Postfach.
HG_WEB3FORMS_ACCESS_KEY=

# Instagram-Lesezugriff, erst nach Freigabe aktivieren. Token niemals committen.
HG_INSTAGRAM_ENABLED=false
HG_INSTAGRAM_ACCESS_TOKEN=
HG_INSTAGRAM_API_VERSION=v25.0
